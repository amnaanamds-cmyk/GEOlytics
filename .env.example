# --- API ---
GEOLYTICS_ENV=development
GEOLYTICS_LOG_LEVEL=INFO

# --- PostgreSQL ---
GEOLYTICS_POSTGRES_DSN=postgresql+psycopg://geolytics:geolytics@localhost:5432/geolytics

# --- Qdrant ---
GEOLYTICS_QDRANT_URL=http://localhost:6333
GEOLYTICS_QDRANT_API_KEY=

# --- Redis (task queue) ---
GEOLYTICS_REDIS_URL=redis://localhost:6379/0

# --- Embeddings ---
# "hashing" needs no model download and is used by the test suite.
# "sentence-transformers" loads GEOLYTICS_EMBEDDING_MODEL locally.
GEOLYTICS_EMBEDDING_BACKEND=hashing
GEOLYTICS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GEOLYTICS_EMBEDDING_DIM=384

# --- Crawler ---
GEOLYTICS_CRAWL_USER_AGENT=GEOlyticsBot/0.1 (+https://github.com/amnaanamds-cmyk/GEOlytics)
GEOLYTICS_CRAWL_MAX_PAGES=100
GEOLYTICS_CRAWL_DELAY_SECONDS=1.0
GEOLYTICS_CRAWL_RESPECT_ROBOTS=true

# --- LLM (answer synthesis + synthetic QA generation) ---
GEOLYTICS_LLM_BACKEND=ollama
GEOLYTICS_OLLAMA_URL=http://localhost:11434
GEOLYTICS_OLLAMA_MODEL=llama3.1:8b
